# Copy to .env and fill in. Never commit .env.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides (defaults shown). Gemini 1.5 models are retired; check AI Studio for current names.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# EMBEDDINGS_BACKEND=auto   # auto | gemini | local
# GEMINI_FALLBACK_MODEL=        # optional backup model if the main one is overloaded
# GEMINI_QUERY_MODEL=           # optional faster model for chat answers (the review keeps using GEMINI_MODEL)
# TOP_K=5
# MAX_PDF_PAGES=50

# --- API for the Angular frontend (frontend/) ---
# DEMO_MODE=true     # public deployments: disables PDF/text uploads on the SERVER, requires policy_id on /audit, enables rate limiting
# CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200   # comma-separated allowlist; set to your deployed frontend origin
# RATE_LIMIT_PER_MIN=0   # per-client limit on costly POST endpoints (default 20 when DEMO_MODE=true, else off)
# MAX_TEXT_CHARS=100000  # cap for pasted policy text
